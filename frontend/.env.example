# React Frontend Environment Configuration Reference (.env.example)

# Backend REST API Endpoint URL
REACT_APP_API_BASE_URL=http://localhost:8080/api

# WebSocket STOMP Stream URL
REACT_APP_WS_URL=ws://localhost:8080/api/ws

# Feature Toggles
REACT_APP_ENABLE_MOCK_TRADING=true
REACT_APP_ENABLE_OAUTH=true
