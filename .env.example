# ===================================================================
# NexTradeX Enterprise Environment Configuration Reference (.env.example)
# ===================================================================

# -------------------------------------------------------------------
# Server & Security Configuration
# -------------------------------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
WS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# JWT Authentication (Minimum 32 characters for 256-bit key)
JWT_SECRET=NexTradeX_Secure_256Bit_Secret_Key_Change_In_Production_Mode!
JWT_EXPIRATION=86400000

# Google OAuth2 Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
OAUTH_REDIRECT_URI=http://localhost:8080/api/login/oauth2/code/google
FRONTEND_CALLBACK_URL=http://localhost:3000/auth

# -------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------
# In-Memory H2 (Development & Testing)
DB_URL=jdbc:h2:mem:nextradb
DB_USERNAME=sa
DB_PASSWORD=
DB_POOL_SIZE=5

# PostgreSQL (Production setup - uncomment for prod):
# DB_URL=jdbc:postgresql://localhost:5432/nextradb?prepareThreshold=0
# DB_USERNAME=postgres
# DB_PASSWORD=your_secure_db_password

# -------------------------------------------------------------------
# Caching, Redis & Token Bucket Rate Limiting
# -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
RATE_LIMITER_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# -------------------------------------------------------------------
# Multi-Exchange Price Feed API Keys & Endpoints
# -------------------------------------------------------------------
# Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Bybit Failover API
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# MEXC Failover API
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_api_secret_here

# CoinMarketCap API
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# -------------------------------------------------------------------
# Observability, Prometheus & Log Tracing
# -------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_NEXTRADEX=DEBUG
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus,metrics
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true

# -------------------------------------------------------------------
# Email & Notification Services (Resend Primary & Brevo Fallback)
# -------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_smtp_username
MAIL_PASSWORD=your_brevo_smtp_password
